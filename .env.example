# Hopr Auth API Environment Configuration
# Store this file as `.env` OUTSIDE the public webroot (e.g., /home/cpaneluser/hopr-api/.env)

APP_ENV=production
APP_DEBUG=false
APP_NAME=Hopr

# Generate a strong random 64-char hex secret:
# php -r "echo bin2hex(random_bytes(32)) . PHP_EOL;"
APP_PEPPER=CHANGE_ME_TO_A_64_CHAR_RANDOM_HEX_SECRET

# MySQL Database (Namecheap cPanel MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cpaneluser_hopr_auth
DB_USER=cpaneluser_hopr_user
DB_PASS=CHANGE_ME_STRONG_DB_PASSWORD

# Authenticated SMTP (e.g., Namecheap Private Email / cPanel Mail / Postmark / SES)
SMTP_HOST=mail.yourdomain.com
SMTP_PORT=465
# Encryption: ssl (port 465) or tls (port 587)
SMTP_ENCRYPTION=ssl
SMTP_USER=noreply@yourdomain.com
SMTP_PASS=CHANGE_ME_SMTP_PASSWORD
SMTP_FROM_EMAIL=noreply@yourdomain.com
SMTP_FROM_NAME=Hopr Security

# Optional: Comma-separated trusted proxy IPs (leave empty on standard cPanel unless behind Cloudflare)
TRUSTED_PROXIES=
