{
    "name": "hopr/auth-api",
    "description": "Production-grade, security-hardened REST Auth API for Hopr desktop app",
    "type": "project",
    "require": {
        "php": ">=8.2",
        "phpmailer/phpmailer": "^6.9"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Hopr\\Auth\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Hopr\\Auth\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
